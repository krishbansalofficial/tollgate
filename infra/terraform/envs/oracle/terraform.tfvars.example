# Copy to terraform.tfvars (gitignored). Values come from the OCI console:
# Profile -> My profile -> API keys -> Add API key (download the private key).
tenancy_ocid        = "ocid1.tenancy.oc1..xxxx"
user_ocid           = "ocid1.user.oc1..xxxx"
fingerprint         = "aa:bb:cc:..."
private_key_path    = "~/.oci/oci_api_key.pem"
region              = "us-ashburn-1"
compartment_ocid    = "ocid1.tenancy.oc1..xxxx" # root compartment, or a dedicated one
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_cidr            = "203.0.113.7/32" # your public IP
