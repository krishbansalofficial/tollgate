# Copy to terraform.tfvars (gitignored). Auth comes from `az login`, not this file.
subscription_id     = "00000000-0000-0000-0000-000000000000" # az account show --query id -o tsv
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_cidr            = "203.0.113.7/32"                       # your public IP: curl -s ifconfig.me
location            = "westus2"                              # must be allowed: az policy assignment list
